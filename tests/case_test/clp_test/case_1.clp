; Quick Logic Test CLP - Ban an so 138/2020/DS-ST (TAND TP. Quy Nhon, Tinh Binh Dinh)
; Tranh chap ve thua ke tai san cua cu Dien Hoa L (chet ngay 06/4/2008, khong de lai di chuc).
; Tai san tranh chap: 1/2 quyen su dung dat tai 197/4 duong C, TP. Quy Nhon.
; Hang thua ke thu nhat: Cu Tran Thi D (vo), cac con: Thanh H, Hoa B (1962), Hoa N, Hoa T1 (chet 2001), Hoa B (1972), Hoa T2.
; Thua ke the vi: Anh Dien Nhat L va anh Dien Duc P (con cua ong Dien Hoa T1).

(analysis-request (case-id case-01-138-2020) (subject case-01-138-2020) (module heir-rank))

; Nguoi de lai di san (Cu Dien Hoa L)
(asserted-fact (fact-id f-deceased-person) (case-id case-01-138-2020) (subject deceased-loi) (predicate deceased-person) (value true))
(asserted-fact (fact-id f-deceased-label) (case-id case-01-138-2020) (subject deceased-loi) (predicate heir-person-label) (value "Cu Dien Hoa L (Nguoi de lai di san)"))

; Trang thai vu viec & tim kiem hang thua ke
(asserted-fact (fact-id f-search-complete) (case-id case-01-138-2020) (subject case-01-138-2020) (predicate heir-search-complete) (value true))
(asserted-fact (fact-id f-has-will) (case-id case-01-138-2020) (subject case-01-138-2020) (predicate has-will) (value false))

; Phan di san (1/2 quyen su dung dat tai 197/4 duong C, TP. Quy Nhon)
(asserted-fact (fact-id f-portion-land) (case-id case-01-138-2020) (subject portion-land) (predicate estate-portion) (value true))
(asserted-fact (fact-id f-portion-label) (case-id case-01-138-2020) (subject portion-land) (predicate estate-portion-label) (value "1/2 dat tai 197/4 duong C, TP. Quy Nhon"))

; Yeu cau chia di san va thoi hieu thua ke (Dieu 623 BLDS 2015, An le 26/2018/AL)
(asserted-fact (fact-id f-limitation-subject) (case-id case-01-138-2020) (subject req-limitation) (predicate limitation-assessment-subject) (value true))
(asserted-fact (fact-id f-limitation-label) (case-id case-01-138-2020) (subject req-limitation) (predicate limitation-request-label) (value "Yeu cau chia di san thua ke quyen su dung dat"))
(asserted-fact (fact-id f-limitation-type) (case-id case-01-138-2020) (subject req-limitation) (predicate request-type) (value divide-estate))
(asserted-fact (fact-id f-limitation-asset) (case-id case-01-138-2020) (subject req-limitation) (predicate asset-type) (value immovable))
(asserted-fact (fact-id f-limitation-date) (case-id case-01-138-2020) (subject req-limitation) (predicate inheritance-opening-date) (value "2008-04-06"))

; 1. Cu Tran Thi D (Vo - sinh 1938, nguyen don)
