(asserted-fact (fact-id f-d-label) (case-id case-01-138-2020) (subject person-dien-thi-d) (predicate heir-person-label) (value "Cu Tran Thi D (Vo - 1938)"))
(asserted-fact (fact-id f-d-spouse) (case-id case-01-138-2020) (subject person-dien-thi-d) (predicate spouse-at-opening) (value deceased-loi))
(asserted-fact (fact-id f-d-life) (case-id case-01-138-2020) (subject person-dien-thi-d) (predicate heir-life-status) (value alive))
(asserted-fact (fact-id f-d-refusal) (case-id case-01-138-2020) (subject person-dien-thi-d) (predicate valid-refusal) (value false))
(asserted-fact (fact-id f-d-el-cand) (case-id case-01-138-2020) (subject person-dien-thi-d) (predicate eligibility-candidate) (value true))
(asserted-fact (fact-id f-d-el-rev) (case-id case-01-138-2020) (subject person-dien-thi-d) (predicate eligibility-review-complete) (value true))

