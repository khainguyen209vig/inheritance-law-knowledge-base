    (status draft))
  (rule-metadata
    (rule-id R-A01)
    (module inheritance-type)
    (legal-source "Điều 649 và Điều 650 khoản 1 điểm a Bộ luật Dân sự 2015")
    (description "Khi hồ sơ xác nhận người chết không để lại di chúc, phần di sản đang xét được xác định thuộc phạm vi thừa kế theo pháp luật.")
    (status draft))
