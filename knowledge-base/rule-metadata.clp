  (rule-metadata
    (rule-id FORM-ASSESSMENT-ACCEPTED)
    (module will-validity)
    (legal-source "Quy tắc chuyển tiếp nội bộ; liên quan Điều 627–636")
    (description "Từ dữ kiện di chúc bằng văn bản và chưa phát hiện khiếm khuyết hình thức, hệ thống tạm ghi nhận điều kiện hình thức đã đạt.")
    (status draft))
  (rule-metadata
    (rule-id R-B01)
    (module will-validity)
    (legal-source "Điều 630 khoản 1 điểm a Bộ luật Dân sự 2015")
    (description "Vì người lập di chúc minh mẫn, sáng suốt và không có dữ kiện về lừa dối hoặc đe dọa, hệ thống suy ra điều kiện về ý chí đã đạt.")
    (status draft))
  (rule-metadata
    (rule-id R-B02)
    (module will-validity)
    (legal-source "Điều 630 khoản 1 điểm b Bộ luật Dân sự 2015")
    (description "Vì không phát hiện nội dung bị cấm và điều kiện hình thức đã đạt, hệ thống suy ra điều kiện về nội dung và hình thức đã đạt.")
    (status draft))
  (rule-metadata
    (rule-id R-B03)
    (module will-validity)
    (legal-source "Điều 630 Bộ luật Dân sự 2015")
    (description "Khi điều kiện về ý chí, nội dung và hình thức đều đã được dẫn xuất là hợp lệ, hệ thống kết luận di chúc hợp pháp.")
    (status draft))
  (rule-metadata
    (rule-id R-B04)
    (module will-validity)
    (legal-source "Điều 630 khoản 1 điểm a Bộ luật Dân sự 2015")
    (description "Trạng thái không minh mẫn hoặc tác động trái ý chí làm điều kiện tại khoản 1 điểm a không được đáp ứng.")
    (status draft))
  (rule-metadata
    (rule-id R-B05)
    (module will-validity)
    (legal-source "Điều 630 khoản 2 Bộ luật Dân sự 2015")
    (description "Độ tuổi, hình thức văn bản và sự đồng ý của cha, mẹ hoặc người giám hộ đáp ứng yêu cầu riêng đối với người chưa thành niên.")
    (status draft))
  (rule-metadata
    (rule-id R-B06)
    (module will-validity)
    (legal-source "Điều 630 khoản 2 Bộ luật Dân sự 2015")
    (description "Người từ 15 đến dưới 18 tuổi không lập di chúc bằng văn bản hoặc không có sự đồng ý cần thiết nên không đạt yêu cầu riêng.")
    (status draft))
  (rule-metadata
    (rule-id R-B07)
    (module will-validity)
    (legal-source "Điều 630 khoản 3 Bộ luật Dân sự 2015")
    (description "Đối với người bị hạn chế thể chất hoặc không biết chữ, văn bản do người làm chứng lập và được công chứng hoặc chứng thực đáp ứng yêu cầu hình thức.")
    (status draft))
  (rule-metadata
    (rule-id R-B08)
    (module will-validity)
    (legal-source "Điều 629 khoản 2 Bộ luật Dân sự 2015")
    (description "Sau ba tháng, người lập vẫn còn sống, minh mẫn và sáng suốt nên di chúc miệng mặc nhiên bị hủy bỏ.")
    (status draft))
  (rule-metadata
    (rule-id R-B09)
    (module will-validity)
    (legal-source "Điều 630 khoản 5 Bộ luật Dân sự 2015")
    (description "Số người làm chứng, việc ghi chép, ký hoặc điểm chỉ và thời hạn xác nhận đáp ứng các điều kiện của di chúc miệng.")
    (status draft))
  (rule-metadata
    (rule-id R-C01)
    (module heir-rank)
    (legal-source "Điều 651 khoản 1 điểm a Bộ luật Dân sự 2015")
    (description "Quan hệ vợ/chồng tại thời điểm mở thừa kế, cha mẹ đẻ hoặc nuôi, và con đẻ hoặc nuôi đặt người đang xét vào nhóm ứng viên hàng thứ nhất. Kết luận này chưa tự động có nghĩa người đó được gọi hưởng.")
    (status draft))
  (rule-metadata
    (rule-id R-C02)
    (module heir-rank)
    (legal-source "Điều 651 khoản 1 điểm b Bộ luật Dân sự 2015")
    (description "Đường quan hệ huyết thống trong graph cho thấy người đang xét là ông/bà, anh/chị/em ruột hoặc cháu ruột mà người chết là ông/bà.")
    (status draft))
  (rule-metadata
    (rule-id R-C03)
    (module heir-rank)
    (legal-source "Điều 651 khoản 1 điểm c Bộ luật Dân sự 2015")
    (description "Đường quan hệ huyết thống trong graph cho thấy người đang xét là cụ, bác/chú/cậu/cô/dì, cháu ruột theo nhánh anh chị em hoặc chắt ruột của người chết.")
    (status draft))
  (rule-metadata
    (rule-id R-C04)
    (module heir-rank)
    (legal-source "Điều 651 khoản 2 Bộ luật Dân sự 2015")
    (description "Khi có từ hai người trở lên cùng được gọi hưởng ở hàng đang hoạt động, hệ thống ghi nhận nguyên tắc cùng hàng hưởng phần bằng nhau; mô-đun này chưa tính giá trị phần chia.")
    (status draft))
  (rule-metadata
    (rule-id R-C05)
    (module heir-rank)
    (legal-source "Điều 651 khoản 3 Bộ luật Dân sự 2015")
    (description "Khi đã xác định có người đủ điều kiện ở một hàng trước, ứng viên thuộc hàng sau chưa được gọi hưởng theo pháp luật.")
    (status draft))
  (rule-metadata
    (rule-id R-C06)
    (module heir-rank)
    (legal-source "Điều 651 khoản 3 Bộ luật Dân sự 2015; kết nối Điều 621")
    (description "Chỉ sau khi danh sách ứng viên được xác nhận đầy đủ, hệ thống chọn hàng thấp nhất còn người sống, không từ chối hợp lệ và không bị loại khỏi thừa kế theo pháp luật.")
    (status draft))
  (rule-metadata
    (rule-id SYSTEM-RANK-CONFLICT)
    (module heir-rank)
    (legal-source "Quy tắc kiểm soát nhất quán của hệ thống")
    (description "Cùng một người được graph quan hệ dẫn xuất vào nhiều hàng khác nhau.")
    (status draft))
  (rule-metadata
    (rule-id STATUTORY-CANDIDATE-QUALIFIED)
    (module heir-rank)
    (legal-source "Quy tắc kết nối nội bộ giữa Điều 621 và Điều 651")
    (description "Ứng viên đã có hàng, còn sống, không từ chối hợp lệ và không bị loại theo Điều 621.")
    (status draft))
  (rule-metadata
    (rule-id STATUTORY-CANDIDATE-INACTIVE)
    (module heir-rank)
    (legal-source "Quy tắc kết nối nội bộ; liên quan Điều 620, Điều 621 và Điều 651")
