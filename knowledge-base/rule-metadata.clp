    (status draft))
  (rule-metadata
    (rule-id REPRESENTATION-CANDIDATE-INACTIVE)
    (module representation)
    (legal-source "Quy tắc kết nối nội bộ; liên quan Điều 620–621 và Điều 652")
    (description "Ứng viên đã chết, từ chối hợp lệ hoặc bị loại khỏi thừa kế theo pháp luật; ngoại lệ chỉ định trong di chúc không tạo quyền thế vị theo pháp luật.")
    (status draft))
  (rule-metadata
    (rule-id R-D01)
    (module eligibility)
    (legal-source "Điều 621 khoản 1 điểm a Bộ luật Dân sự 2015")
    (description "Ứng viên có bản án về hành vi cố ý xâm phạm tính mạng, sức khỏe hoặc hành vi ngược đãi, hành hạ, xâm phạm nghiêm trọng danh dự, nhân phẩm người để lại di sản.")
    (status draft))
  (rule-metadata
    (rule-id R-D02)
    (module eligibility)
    (legal-source "Điều 621 khoản 1 điểm b Bộ luật Dân sự 2015")
    (description "Ứng viên vi phạm nghiêm trọng nghĩa vụ nuôi dưỡng người để lại di sản.")
    (status draft))
  (rule-metadata
    (rule-id R-D03)
    (module eligibility)
    (legal-source "Điều 621 khoản 1 điểm c Bộ luật Dân sự 2015")
    (description "Ứng viên bị kết án về hành vi cố ý xâm phạm tính mạng người thừa kế khác và có mục đích hưởng thêm di sản.")
    (status draft))
  (rule-metadata
    (rule-id R-D04a)
    (module eligibility)
    (legal-source "Điều 621 khoản 1 điểm d Bộ luật Dân sự 2015")
    (description "Ứng viên có hành vi lừa dối hoặc cưỡng ép người để lại di sản trong việc lập di chúc.")
