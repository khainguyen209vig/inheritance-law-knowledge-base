    (rule-id R-D05)
    (module eligibility)
    (legal-source "Điều 621 khoản 2 Bộ luật Dân sự 2015")
    (description "Dù thuộc khoản 1, người này vẫn có thể hưởng theo di chúc nếu người để lại di sản biết hành vi nhưng vẫn cho hưởng.")
    (status draft))
  (rule-metadata
