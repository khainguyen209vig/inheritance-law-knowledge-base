  (rule-metadata
    (rule-id R-D04b)
    (module eligibility)
    (legal-source "Điều 621 khoản 1 điểm d Bộ luật Dân sự 2015")
    (description "Ứng viên giả mạo, sửa, hủy hoặc che giấu di chúc nhằm hưởng di sản trái ý chí người để lại di sản.")
    (status draft))
