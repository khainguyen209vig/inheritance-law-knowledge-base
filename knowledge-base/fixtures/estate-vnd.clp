(analysis-request (case-id estate-vnd-case) (subject estate-vnd-calculation) (module estate-settlement))

(asserted-fact (fact-id vnd-scope) (case-id estate-vnd-case) (subject estate-vnd-calculation) (predicate estate-vnd-calculation) (value true))
(asserted-fact (fact-id vnd-assets-complete) (case-id estate-vnd-case) (subject estate-vnd-calculation) (predicate estate-asset-set-complete) (value true))
(asserted-fact (fact-id vnd-obligations-complete) (case-id estate-vnd-case) (subject estate-vnd-calculation) (predicate estate-obligation-set-complete) (value true))

; Confirmed valuations and ownership ratios. The house leaves a 1/2 VND remainder.
(asserted-fact (fact-id house) (case-id estate-vnd-case) (subject house-one) (predicate estate-asset) (value true))
(asserted-fact (fact-id house-value) (case-id estate-vnd-case) (subject house-one) (predicate asset-value-vnd) (value 3000000001))
(asserted-fact (fact-id house-owner-n) (case-id estate-vnd-case) (subject house-one) (predicate deceased-ownership-numerator) (value 1))
(asserted-fact (fact-id house-owner-d) (case-id estate-vnd-case) (subject house-one) (predicate deceased-ownership-denominator) (value 2))
(asserted-fact (fact-id bank) (case-id estate-vnd-case) (subject bank-one) (predicate estate-asset) (value true))
(asserted-fact (fact-id bank-value) (case-id estate-vnd-case) (subject bank-one) (predicate asset-value-vnd) (value 500000000))
(asserted-fact (fact-id bank-owner-n) (case-id estate-vnd-case) (subject bank-one) (predicate deceased-ownership-numerator) (value 1))
(asserted-fact (fact-id bank-owner-d) (case-id estate-vnd-case) (subject bank-one) (predicate deceased-ownership-denominator) (value 1))

(asserted-fact (fact-id funeral) (case-id estate-vnd-case) (subject funeral-one) (predicate estate-obligation) (value true))
(asserted-fact (fact-id funeral-type) (case-id estate-vnd-case) (subject funeral-one) (predicate obligation-type) (value funeral-expense))
(asserted-fact (fact-id funeral-amount) (case-id estate-vnd-case) (subject funeral-one) (predicate obligation-amount-vnd) (value 100000000))
(asserted-fact (fact-id debt) (case-id estate-vnd-case) (subject debt-one) (predicate estate-obligation) (value true))
(asserted-fact (fact-id debt-type) (case-id estate-vnd-case) (subject debt-one) (predicate obligation-type) (value other-debt))
(asserted-fact (fact-id debt-amount) (case-id estate-vnd-case) (subject debt-one) (predicate obligation-amount-vnd) (value 200000000))

; Two qualified first-rank heirs make the statutory share deterministic.
(asserted-fact (fact-id deceased) (case-id estate-vnd-case) (subject deceased-one) (predicate deceased-person) (value true))
(asserted-fact (fact-id heirs-complete) (case-id estate-vnd-case) (subject estate-vnd-case) (predicate heir-search-complete) (value true))
(asserted-fact (fact-id child-one-candidate) (case-id estate-vnd-case) (subject child-one) (predicate heir-rank-candidate) (value true))
(asserted-fact (fact-id child-one-edge) (case-id estate-vnd-case) (subject deceased-one) (predicate biological-parent-of) (value child-one))
(asserted-fact (fact-id child-one-life) (case-id estate-vnd-case) (subject child-one) (predicate heir-life-status) (value alive))
(asserted-fact (fact-id child-one-eligibility) (case-id estate-vnd-case) (subject child-one) (predicate eligibility-candidate) (value true))
(asserted-fact (fact-id child-one-review) (case-id estate-vnd-case) (subject child-one) (predicate eligibility-review-complete) (value true))
(asserted-fact (fact-id child-one-refusal) (case-id estate-vnd-case) (subject child-one) (predicate valid-refusal) (value false))
(asserted-fact (fact-id child-one-compulsory-scope) (case-id estate-vnd-case) (subject child-one) (predicate compulsory-share-assessment-subject) (value true))
(asserted-fact (fact-id child-one-age) (case-id estate-vnd-case) (subject child-one) (predicate age-group) (value minor))
(asserted-fact (fact-id child-one-testamentary-vnd) (case-id estate-vnd-case) (subject child-one) (predicate testamentary-share-received-vnd) (value 100000000))
(asserted-fact (fact-id child-two-candidate) (case-id estate-vnd-case) (subject child-two) (predicate heir-rank-candidate) (value true))
(asserted-fact (fact-id child-two-edge) (case-id estate-vnd-case) (subject deceased-one) (predicate biological-parent-of) (value child-two))
(asserted-fact (fact-id child-two-life) (case-id estate-vnd-case) (subject child-two) (predicate heir-life-status) (value alive))
(asserted-fact (fact-id child-two-eligibility) (case-id estate-vnd-case) (subject child-two) (predicate eligibility-candidate) (value true))
(asserted-fact (fact-id child-two-review) (case-id estate-vnd-case) (subject child-two) (predicate eligibility-review-complete) (value true))
(asserted-fact (fact-id child-two-refusal) (case-id estate-vnd-case) (subject child-two) (predicate valid-refusal) (value false))
